diff --git a/packages/runtime/src/scr_json.c b/packages/runtime/src/scr_json.c
index 105816f8a..51451d8dc 100644
--- a/packages/runtime/src/scr_json.c
+++ b/packages/runtime/src/scr_json.c
@@ -1208,6 +1208,16 @@ static void scr_dyn_region_leave(ScrDyn *d) {
 #define SCR_STAT_DYN_ALLOC(kind) ((void)0)
 #endif
 
+/* Young-in nursery membership (scr_cycle.c, SCR_YIN): objects, arrays and
+ * function values enter the nursery at allocation, after their count is
+ * stored. A young node is never a cycle candidate; the nursery collection
+ * frees young cycles and promotes the rest. */
+#ifdef SCR_YIN
+static inline void scr_dyn_young(ScrDyn *d) { scr_yin_enter_inline(d); }
+#else
+#define scr_dyn_young(d) ((void)0)
+#endif
+
 static ScrDyn *scr_dyn_alloc(ScrDynKind kind) {
   SCR_STAT_DYN_ALLOC(kind);
 #ifndef SCR_RC_AUDIT
@@ -1250,6 +1260,7 @@ static ScrDyn *scr_dyn_alloc(ScrDynKind kind) {
       /* Number and string boxes set their one payload word. */
       memset(&d->v, 0, sizeof d->v);
     }
+    if (kind == SCR_DYN_ARR || kind == SCR_DYN_OBJ || kind == SCR_DYN_FUNC) scr_dyn_young(d);
     return d;
   }
 #endif
@@ -1269,6 +1280,7 @@ static ScrDyn *scr_dyn_alloc(ScrDynKind kind) {
 #ifdef SCR_RC_AUDIT
   scr_live_dyns++;
 #endif
+  if (kind == SCR_DYN_ARR || kind == SCR_DYN_OBJ || kind == SCR_DYN_FUNC) scr_dyn_young(fresh);
   return fresh;
 }
 
@@ -1319,6 +1331,7 @@ static inline ScrDyn *scr_dyn_func_alloc(void) {
     d->null_proto = false;
     d->copied_from_native = false;
     d->non_extensible = false;
+    scr_dyn_young(d);
     return d;
   }
 #endif
diff --git a/packages/runtime/src/scr_rc.h b/packages/runtime/src/scr_rc.h
index b74598010..8d8417853 100644
--- a/packages/runtime/src/scr_rc.h
+++ b/packages/runtime/src/scr_rc.h
@@ -801,6 +801,25 @@ typedef struct ScrYin {
   size_t cap;
 } ScrYin;
 extern SCR_TL ScrYin scr_yin;
+/* The runtime's own allocation paths (dyn nodes, closures, boxes) enter the
+ * nursery through this inline half, as the emitted constructors do; its
+ * fallback is the whole entry. */
+#if !defined(SCR_WORKERS) && !(defined(SCR_LIB) && defined(SCR_THREAD_INSTANCES)) && defined(SCR_YIN)
+static inline void scr_yin_enter_inline(void *obj) {
+  ScrCycHdr *h = scr_cyc_hdr(obj);
+  size_t n = scr_yin.n;
+  if (__builtin_expect(scr_yin_skip[h->id] == 0 && n < scr_yin.lim, 1)) {
+    scr_yin.v[n] = obj;
+    scr_yin.n = n + 1;
+    h->gen = SCR_CYC_YOUNG;
+    h->buf = SCR_CYC_BUFFERED_BIT | (uint32_t)n;
+    return;
+  }
+  scr_yin_enter(obj);
+}
+#else
+#define scr_yin_enter_inline(obj) scr_yin_enter(obj)
+#endif
 #if UINTPTR_MAX == UINT64_MAX
 _Static_assert(offsetof(ScrYin, n) == 8 && offsetof(ScrYin, lim) == 16,
                "llvm/shapes.ts appends to the nursery at these offsets");
