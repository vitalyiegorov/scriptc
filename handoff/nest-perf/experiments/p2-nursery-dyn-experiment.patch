   scr_cyc_set_gen(h, SCR_CYC_NURSERY);
-  scr_yin_met(h->id, false);
+  if (!scr_yin_all()) scr_yin_met(h->id, false);
 }
 
 static void scr_yin_count_visit(void *child, void *ctx) {
@@ -1853,7 +1864,12 @@ static __attribute__((noinline)) size_t scr_yin_collect(void) {
   SCR_STAT_ADD(yin_dead, freed);
   for (size_t i = 0; i < scr_yin_dead.n; i++) {
     void *obj = scr_yin_dead.v[i];
-    scr_cyc_type(scr_cyc_hdr(obj))->free_fn(obj);
+    ScrCycHdr *dh = scr_cyc_hdr(obj);
+    /* Out of the nursery before teardown: a pooled node (dyn nodes) keeps
+     * its header, and must not carry a stale position into its next life. */
+    scr_cyc_clear_buffered(dh);
+    scr_cyc_set_gen(dh, SCR_CYC_NURSERY);
+    scr_cyc_type(dh)->free_fn(obj);
   }
   scr_yin_dead.n = 0;
